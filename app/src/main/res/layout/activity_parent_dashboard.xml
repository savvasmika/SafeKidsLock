<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ Λειτουργία Γονέα"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvParentNetworkStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🟢 Συνδεδεμένο στο δίκτυο (FAMILY-1001)"
            android:textColor="@color/emerald_success"
            android:textSize="13sp" />

        <!-- Unlock Request Alert Card -->
        <LinearLayout
            android:id="@+id/cardIncomingRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_card"
            android:backgroundTint="@color/surface_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 Εισερχόμενο Αίτημα Ξεκλειδώματος!"
                android:textColor="@color/amber_warning"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIncomingChildName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Το παιδί ζητάει ξεκλείδωμα του τάμπλετ."
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#1e293b"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIN ΞΕΚΛΕΙΔΩΜΑΤΟΣ: "
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMatchingPin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7492"
                    android:textColor="@color/primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApproveRemoteUnlock"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/emerald_success"
                android:text="✨ Έγκριση &amp; Άμεσο Ξεκλείδωμα"
                android:textColor="@color/text_white"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Quick Remote Controls -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="ΤΗΛΕΧΕΙΡΙΣΜΟΣ ΤΑΜΠΛΕΤ"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoteLock"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/rose_danger"
                android:text="🔒 Κλείδωμα"
                android:textColor="@color/text_white"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExtendTime15"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/primary"
                android:text="+15 Λεπτά"
                android:textColor="@color/background_dark"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
