<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="horizontal"
    android:padding="20dp">

    <!-- Left Side: Time, Status, Request Unlock Button -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:41"
            android:textColor="@color/text_white"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Τάμπλετ Παιδιού • Κλειδωμένο"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Πατήστε παρακάτω για να ζητήσετε κωδικό από τον γονέα."
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestUnlock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary"
            android:text="📡 Ζήτησε Κωδικό από τον Γονέα"
            android:textColor="@color/background_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSentNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#164e63"
            android:padding="10dp"
            android:text="✅ Το αίτημα στάλθηκε! Περιμένετε έγκριση ή πληκτρολογήστε το PIN."
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Right Side: PIN Entry Keypad -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ΠΛΗΚΤΡΟΛΟΓΗΣΤΕ 4-ΨΗΦΙΟ PIN"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- PIN Display Dots -->
        <TextView
            android:id="@+id/tvPinDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:letterSpacing="0.4"
            android:text="••••"
            android:textColor="@color/primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Simple Grid of Keys -->
        <TableLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TableRow>
                <Button android:id="@+id/btn1" style="@style/Widget.Material3.Button.TonalButton" android:text="1" android:textSize="20sp" />
                <Button android:id="@+id/btn2" style="@style/Widget.Material3.Button.TonalButton" android:text="2" android:textSize="20sp" />
                <Button android:id="@+id/btn3" style="@style/Widget.Material3.Button.TonalButton" android:text="3" android:textSize="20sp" />
            </TableRow>

            <TableRow>
                <Button android:id="@+id/btn4" style="@style/Widget.Material3.Button.TonalButton" android:text="4" android:textSize="20sp" />
                <Button android:id="@+id/btn5" style="@style/Widget.Material3.Button.TonalButton" android:text="5" android:textSize="20sp" />
                <Button android:id="@+id/btn6" style="@style/Widget.Material3.Button.TonalButton" android:text="6" android:textSize="20sp" />
            </TableRow>

            <TableRow>
                <Button android:id="@+id/btn7" style="@style/Widget.Material3.Button.TonalButton" android:text="7" android:textSize="20sp" />
                <Button android:id="@+id/btn8" style="@style/Widget.Material3.Button.TonalButton" android:text="8" android:textSize="20sp" />
                <Button android:id="@+id/btn9" style="@style/Widget.Material3.Button.TonalButton" android:text="9" android:textSize="20sp" />
            </TableRow>

            <TableRow>
                <Button android:id="@+id/btnClear" style="@style/Widget.Material3.Button.TonalButton" android:text="C" android:textSize="18sp" android:textColor="@color/rose_danger" />
                <Button android:id="@+id/btn0" style="@style/Widget.Material3.Button.TonalButton" android:text="0" android:textSize="20sp" />
                <Button android:id="@+id/btnDel" style="@style/Widget.Material3.Button.TonalButton" android:text="⌫" android:textSize="18sp" />
            </TableRow>

        </TableLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Κωδικός Έκτακτης Ανάγκης: 0000"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
